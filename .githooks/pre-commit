#!/bin/sh
# Inspect the index without staging, reformatting, committing or deploying anything.
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v node >/dev/null 2>&1; then
  active_node="$(command -v node)"
elif [ -x "$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" ]; then
  active_node="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
else
  echo '0161 checks need Node.js 22.13 or newer on PATH.' >&2
  exit 1
fi
if [ ! -d node_modules/eslint ]; then
  echo 'Install development check tools first: pnpm install --frozen-lockfile --ignore-scripts' >&2
  exit 1
fi
exec "$active_node" scripts/check-code.mjs --staged
